    {
      "name": "4. Roles",
      "description": "Flujo de un usuario MEMBER: se registra (queda PENDING), el ADMIN lo activa y solo puede consultar artículos. Nota: si el SMTP está configurado, el registro y la activación envían correos al email de prueba.",
      "item": [
        {
          "name": "Registrar usuario MEMBER",
          "event": [
            {
              "listen": "prerequest",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "const suffix = Date.now();",
                  "pm.collectionVariables.set(\"memberId\", \"usr-postman-\" + suffix);",
                  "pm.collectionVariables.set(\"memberEmail\", \"postman.\" + suffix + \"@example.com\");",
                  "pm.collectionVariables.set(\"memberPassword\", \"Postman1234\");"
                ]
              }
            },
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"Usuario registrado (201)\", () => pm.response.to.have.status(201));",
                  "pm.test(\"Queda en estado PENDING\", () => pm.expect(pm.response.json().status).to.eql(\"PENDING\"));"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"

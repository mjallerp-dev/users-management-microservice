    {
      "name": "2. Auth",
      "description": "Login del ADMIN. Guarda el token en la variable de entorno `token`, que heredan las demás peticiones.",
      "item": [
        {
          "name": "Login con credenciales inválidas",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"Credenciales rechazadas (401)\", () => pm.response.to.have.status(401));",
                  "pm.test(\"Cuerpo de error con status 401\", () => pm.expect(pm.response.json().status).to.eql(401));"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [

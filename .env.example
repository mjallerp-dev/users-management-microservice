# ================================================================
# Plantilla de variables de entorno — este archivo SÍ se sube al
# repositorio. Contiene las claves necesarias pero SIN valores reales.
#
# Para configurar el proyecto:
#   cp .env.example .env
# y rellena los valores según tu entorno local o de producción.
# Los valores van sin comillas: Spring lee este archivo como .properties.
# ================================================================

# Base de datos (PostgreSQL)
# DB_SSL_MODE: disable en local; require en Azure Database for PostgreSQL.
DB_HOST=127.0.0.1
DB_PORT=5432
DB_NAME=pgarticlesdb
DB_USERNAME=postgres
DB_PASSWORD=your_password_here
DB_SSL_MODE=require

# ----------------------------------------------------------------
# Correo electrónico (SMTP)
# Para Gmail: activa la verificación en 2 pasos y genera una
# "Contraseña de aplicación" en Cuenta Google → Seguridad.
# Para pruebas locales puedes usar Mailtrap (sandbox.smtp.mailtrap.io).
# ----------------------------------------------------------------
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USERNAME=email_que_envia@proveedor.com
SMTP_PASSWORD=xxxxxxxxxxxxxxxx
SMTP_FROM_ADDRESS=email_que_envia@proveedor.com
SMTP_FROM_NAME=Gestion de Usuarios

# ----------------------------------------------------------------
# Proveedor de correo: smtp (por defecto) o brevo.
# Usa brevo en Render: su plan gratuito bloquea los puertos SMTP.
# Con brevo, SMTP_FROM_ADDRESS debe ser un remitente verificado en Brevo
# y la API key se genera en Brevo > SMTP & API > API Keys.
# ----------------------------------------------------------------
EMAIL_PROVIDER=smtp
BREVO_API_KEY=

# ----------------------------------------------------------------
# Seguridad JWT
# JWT_SECRET: al menos 32 bytes aleatorios en Base64
# (por ejemplo: openssl rand -base64 48).
# ----------------------------------------------------------------
JWT_SECRET=change_me
JWT_EXPIRATION_SECONDS=900
